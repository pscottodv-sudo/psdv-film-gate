# Concatenates the portable core and the Metal entry point into one C string.
# Usage: cmake -DSRC_DIR=... -DOUT=... -P embed_kernel.cmake
set(parts
    "${SRC_DIR}/core/psdv_prelude.h"
    "${SRC_DIR}/core/psdv_params.h"
    "${SRC_DIR}/core/psdv_core.h"
    "${SRC_DIR}/metal/psdv_kernel_body.metal")
set(body "")
foreach(f IN LISTS parts)
    file(READ "${f}" txt)
    string(REGEX REPLACE "#include \"[^\"]*\"" "" txt "${txt}")
    string(REPLACE "#pragma once" "" txt "${txt}")
    string(APPEND body "// ---- ${f}\n${txt}\n")
endforeach()
file(WRITE "${OUT}" "// generated by cmake/embed_kernel.cmake - do not edit\n#pragma once\nstatic const char* kPsdvKernelSource = R\"PSDVKERNEL(\n${body})PSDVKERNEL\";\n")
